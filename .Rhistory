#!/usr/bin/env Rscript
# ═══════════════════════════════════════════════════════════════════
# clean_disaster_data.R
#
# Cleans the raw EM-DAT export (disaster_oceania.xlsx) into the exact
# shape the "roll call" chapter's waffle chart expects:
#   [{ year, type, country, affected }, ...]
#
# Run:  Rscript clean_disaster_data.R disaster_oceania.xlsx events.json
#
# Requires: readxl, dplyr, jsonlite
#   install.packages(c("readxl","dplyr","jsonlite"))
# ═══════════════════════════════════════════════════════════════════
library(readxl)
library(dplyr)
library(jsonlite)
args     <- commandArgs(trailingOnly = TRUE)
in_path  <- if (length(args) >= 1) args[1] else "disaster_oceania.xlsx"
out_path <- if (length(args) >= 2) args[2] else "events.json"
# ── 1 · read ─────────────────────────────────────────────────────────
raw <- read_excel(in_path, sheet = "EM-DAT Data")
#!/usr/bin/env Rscript
# ═══════════════════════════════════════════════════════════════════
# clean_disaster_data.R
#
# Cleans the raw EM-DAT export (disaster_oceania.xlsx) into the exact
# shape the "roll call" chapter's waffle chart expects:
#   [{ year, type, country, affected }, ...]
#
# Run:  Rscript clean_disaster_data.R disaster_oceania.xlsx events.json
#
# Requires: readxl, dplyr, jsonlite
#   install.packages(c("readxl","dplyr","jsonlite"))
# ═══════════════════════════════════════════════════════════════════
suppressPackageStartupMessages({
library(readxl)
library(dplyr)
library(jsonlite)
})
args     <- commandArgs(trailingOnly = TRUE)
in_path  <- if (length(args) >= 1) args[1] else "disaster_oceania.xlsx"
out_path <- if (length(args) >= 2) args[2] else "events.json"
# ── 1 · read ─────────────────────────────────────────────────────────
