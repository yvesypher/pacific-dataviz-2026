#!/usr/bin/env Rscript
# ═══════════════════════════════════════════════════════════════════
# clean_disaster_data.R
#
# Cleans the raw EM-DAT export (disaster_oceania.xlsx) into the exact
# shape the "roll call" chapter's waffle chart expects:
#   [{ year, type, country, affected }, ...]
#
# Run:  Rscript clean_disaster_data.R disaster_oceania.xlsx events.json
#
# Requires: readxl, dplyr, jsonlite
#   install.packages(c("readxl","dplyr","jsonlite"))
# ═══════════════════════════════════════════════════════════════════
suppressPackageStartupMessages({
library(readxl)
library(dplyr)
library(jsonlite)
})
args     <- commandArgs(trailingOnly = TRUE)
in_path  <- if (length(args) >= 1) args[1] else "data/disaster_oceania.xlsx"
out_path <- if (length(args) >= 2) args[2] else "data/events.json"
# ── 1 · read ─────────────────────────────────────────────────────────
raw <- read_excel(in_path, sheet = "EM-DAT Data")
cat(sprintf("Read %d rows from '%s'\n", nrow(raw), in_path))
# ── 2 · restrict to the 22 Pacific Island Countries and Territories ──
# EM-DAT's Oceania region also includes Australia and New Zealand,
# which are not part of this piece's 22 PICTs and get dropped here.
# ISO3 -> the exact `name` strings PICT already uses in the HTML, so
# the output joins straight onto the existing PICT array with no
# further renaming needed on the JS side.
iso3_to_pict_name <- c(
PNG = "Papua New Guinea",       SLB = "Solomon Islands",
VUT = "Vanuatu",                NCL = "New Caledonia",
FJI = "Fiji",                   TON = "Tonga",
WSM = "Samoa",                  ASM = "American Samoa",
NIU = "Niue",                   COK = "Cook Islands",
PYF = "French Polynesia",       WLF = "Wallis and Futuna",
TKL = "Tokelau",                TUV = "Tuvalu",
KIR = "Kiribati",               NRU = "Nauru",
MHL = "Marshall Islands",       FSM = "Micronesia (FS)",
PLW = "Palau",                  GUM = "Guam",
MNP = "N. Mariana Islands",     PCN = "Pitcairn"
)
pict <- raw %>% filter(ISO %in% names(iso3_to_pict_name))
cat(sprintf(
"Kept %d rows for the 22 PICTs (dropped %d — mostly Australia/New Zealand)\n",
nrow(pict), nrow(raw) - nrow(pict)
))
# ── 3 · recode into the four hazard buckets the waffle chart uses ────
# The piece is specifically about climate-driven disasters, matching
# its own chapter framing ("cyclones set the rhythm, but flood,
# drought and storm surge take a rising share"). EM-DAT's Oceania
# extract also contains earthquakes, volcanic activity, wildfire and
# epidemics — geophysical or biological, not climate hazards — which
# are intentionally excluded here rather than silently folded into
# one of the four buckets.
#
# "Storm surge" is EM-DAT's own subtype but is almost never used in
# practice (1 row in this extract) — coastal flood is the subtype
# that actually captures storm-surge-driven inundation, so the two
# are combined into one bucket.
recode_hazard <- function(type, subtype) {
case_when(
type == "Storm"                                    ~ "Cyclone",
type == "Flood" & subtype == "Coastal flood"        ~ "Storm surge",
subtype == "Storm surge"                            ~ "Storm surge",
type == "Flood"                                     ~ "Flood",
type == "Drought"                                   ~ "Drought",
TRUE                                                ~ NA_character_
)
}
pict <- pict %>%
mutate(hazard = recode_hazard(`Disaster Type`, `Disaster Subtype`))
excluded <- pict %>% filter(is.na(hazard)) %>% count(`Disaster Type`, sort = TRUE)
cat("Excluded non-climate disaster types (kept out of the waffle chart):\n")
print(excluded, n = Inf)
pict <- pict %>% filter(!is.na(hazard))
# ── 4 · one row per event: year, hazard bucket, country, people affected ──
# EM-DAT reports affected counts across several columns that aren't
# always all populated for the same event. "Total Affected" is the
# field to prefer (deaths + injured + affected + homeless, EM-DAT's
# own composite); fall back to "No. Affected" alone, then to 0 rather
# than dropping the event entirely — an event with an unknown affected
# count is still a real event for the "how many, how often" step.
events <- pict %>%
transmute(
year    = `Start Year`,
type    = hazard,
country = iso3_to_pict_name[ISO],
affected = case_when(
!is.na(`Total Affected`) ~ `Total Affected`,
!is.na(`No. Affected`)   ~ `No. Affected`,
TRUE                     ~ 0
)
) %>%
filter(!is.na(year)) %>%
arrange(year, country)
cat(sprintf("\nFinal event count: %d\n", nrow(events)))
cat("By hazard:\n"); print(table(events$type))
cat(sprintf("Year range: %d - %d\n", min(events$year), max(events$year)))
# ── 5 · write ──────────────────────────────────────────────────────
write_json(events, out_path, auto_unbox = TRUE, pretty = TRUE)
cat(sprintf("\nWrote %s\n", out_path))
pict
View(pict)
events
View(events)
suppressPackageStartupMessages({
library(dplyr)
library(jsonlite)
})
args <- commandArgs(trailingOnly = TRUE)
sst_path  <- if (length(args) >= 1) args[1] else "data/seasurfacetemp_anomalies.csv"
sea_path  <- if (length(args) >= 2) args[2] else "data/sealevel_anomalies.csv"
rain_path <- if (length(args) >= 3) args[3] else "data/rainfall_anomalies.csv"
out_path  <- if (length(args) >= 4) args[4] else "data/anomalies.json"
# The 22 PICTs this piece covers — anything else in the export (there
# shouldn't be any here, but this guards against a wider regional pull
# in a future refresh) is dropped rather than silently averaged in.
PICT_ISO2 <- c("PG","SB","VU","NC","FJ","TO","WS","AS","NU","CK","PF",
"WF","TK","TV","KI","NR","MH","FM","PW","GU","MP","PN")
# ── shared reader: PDH's SDMX-CSV always has the real header on row 1
# and one DATAFLOW row per observation — no metadata rows to skip. ───
read_pdh <- function(path) {
df <- read.csv(path, stringsAsFactors = FALSE)
df %>%
filter(GEO_PICT %in% PICT_ISO2, !is.na(OBS_VALUE), OBS_VALUE != "") %>%
transmute(iso = GEO_PICT, year = as.integer(TIME_PERIOD),
value = as.numeric(OBS_VALUE))
}
# ── regional annual average: unweighted mean across every PICT that
# reported that year. This also does useful work on the sea-level
# file specifically — see note below. ─────────────────────────────
regional_mean <- function(df, label) {
out <- df %>%
group_by(year) %>%
summarise(value = mean(value, na.rm = TRUE), n = n(), .groups = "drop") %>%
arrange(year)
cat(sprintf(
"%-6s %d years (%d-%d), averaged across %d-%d countries per year\n",
label, nrow(out), min(out$year), max(out$year), min(out$n), max(out$n)
))
out
}
sst  <- read_pdh(sst_path)  %>% regional_mean("SST")
sea  <- read_pdh(sea_path)  %>% regional_mean("Sea level")
rain <- read_pdh(rain_path) %>% regional_mean("Rainfall")
# ── sea level: convert metres to millimetres ──────────────────────
# PDH reports this file to the nearest 0.1 m per country (only 5
# distinct values — -0.2 to 0.2 — appear in the entire raw file), a
# real precision limit of the source, not a cleaning artefact. The
# regional average smooths this into a continuous-looking series
# because it's a mean across ~20 differently-rounded countries each
# year, not because any single country's reading got more precise.
sea <- sea %>% mutate(value = value * 1000)
# ── each indicator keeps its own natural year range rather than being
# cut down to the shortest one. SST has 175 years of record (from
# 1850); truncating it to sea level's 1993–2023 window for the sake of
# a shared table would throw away exactly the long-run signal this
# chapter's first step is trying to show. The three series are written
# out separately and the chart's x-axis is scaled per indicator. ──────
result <- list(
sst  = sst  %>% select(year, value),
sea  = sea  %>% select(year, value),
rain = rain %>% select(year, value)
)
write_json(result, out_path, auto_unbox = TRUE, pretty = TRUE, digits = 4)
cat(sprintf("\nWrote %s\n", out_path))
events
View(events)
pict
View(pict)
library(readxl)
library(dplyr)
library(jsonlite)
args     <- commandArgs(trailingOnly = TRUE)
in_path  <- if (length(args) >= 1) args[1] else "disaster_oceania.xlsx"
out_path <- if (length(args) >= 2) args[2] else "data/events.json"
raw <- read_excel(in_path, sheet = "EM-DAT Data")
library(readxl)
library(dplyr)
library(jsonlite)
args     <- commandArgs(trailingOnly = TRUE)
in_path  <- if (length(args) >= 1) args[1] else "data/disaster_oceania.xlsx"
out_path <- if (length(args) >= 2) args[2] else "data/events.json"
raw <- read_excel(in_path, sheet = "EM-DAT Data")
cat(sprintf("Read %d rows from '%s'\n", nrow(raw), in_path))
iso3_to_pict_name <- c(
PNG = "Papua New Guinea",        SLB = "Solomon Islands",
VUT = "Vanuatu",                 NCL = "New Caledonia",
FJI = "Fiji",                    TON = "Tonga",
WSM = "Samoa",                   ASM = "American Samoa",
NIU = "Niue",                    COK = "Cook Islands",
PYF = "French Polynesia",        WLF = "Wallis and Futuna",
TKL = "Tokelau",                 TUV = "Tuvalu",
KIR = "Kiribati",                NRU = "Nauru",
MHL = "Marshall Islands",        FSM = "Micronesia (FS)",
PLW = "Palau",                   GUM = "Guam",
MNP = "N. Mariana Islands",      PCN = "Pitcairn"
)
pict <- raw |> filter(ISO %in% names(iso3_to_pict_name))
cat(sprintf(
"Kept %d rows for the 22 PICTs (dropped %d — mostly Australia/New Zealand)\n",
nrow(pict), nrow(raw) - nrow(pict)
))
# Extract the base affected counts before grouping
pict <- pict |>
mutate(
country = iso3_to_pict_name[ISO],
affected_count = case_when(
!is.na(`Total Affected`) ~ `Total Affected`,
!is.na(`No. Affected`)   ~ `No. Affected`,
TRUE                     ~ 0
)
)
# Group by Disaster Subgroup, country, and year
events <- pict |>
filter(!is.na(`Start Year`), !is.na(`Disaster Subgroup`)) |>
group_by(
year = `Start Year`,
country,
type = `Disaster Subgroup`
) |>
summarise(
affected = sum(affected_count, na.rm = TRUE),
event_count = n(),
.groups = "drop"
) |>
arrange(year, country, type)
cat(sprintf("\nFinal grouped event count: %d\n", nrow(events)))
cat("By Disaster Subgroup:\n"); print(table(events$type))
cat(sprintf("Year range: %d - %d\n", min(events$year), max(events$year)))
write_json(events, out_path, auto_unbox = TRUE, pretty = TRUE)
cat(sprintf("\nWrote %s\n", out_path))
View(events)
library(readr)
library(dplyr)
library(jsonlite)
# Define file paths
in_path <- "data/greenhouse_gaz_emission_per_capita.csv"
out_path <- "data/ghg_emissions.json"
# Read the data
df <- read_csv(in_path)
# Clean and calculate the Pacific Island average per year
pacific_avg <- df %>%
filter(!is.na(TIME_PERIOD), !is.na(OBS_VALUE)) %>%
group_by(year = TIME_PERIOD) %>%
summarize(
mean_value = mean(OBS_VALUE, na.rm = TRUE),
median_value = median(OBS_VALUE, na.rm = TRUE)
) %>%
arrange(year)
cat(sprintf("Read %d rows, aggregated to %d years.\n", nrow(df), nrow(pacific_avg)))
# Export to JSON
write_json(pacific_avg, out_path, auto_unbox = TRUE, pretty = TRUE)
cat(sprintf("Wrote %s\n", out_path))
